---
import Teardown from './Teardown.astro';
---

<section class="hero" data-hero aria-labelledby="hero-title">
  <div class="copy">
    <h1 id="hero-title">
      <span>I make software, art, and the occasional mess.</span>
      <span>Usually in that order.</span>
    </h1>
    <p class="sub">
      Michael VanDyke. Engineering leader, artist, and lifelong maker in Louisville, Kentucky.
    </p>
    <p class="actions">
      <a href="/projects/">See what I've made</a>
      <a href="/resume/">Work with me</a>
    </p>
  </div>
  <div class="figure">
    <Teardown />
  </div>
</section>

<style>
  .hero {
    display: grid;
    gap: var(--space-4);
    align-items: center;
    padding-bottom: var(--space-4);
  }

  h1 {
    font-size: clamp(2.75rem, 7vw, 6.5rem);
    line-height: 0.92;
    margin-bottom: var(--space-3);
  }

  h1 span {
    display: block;
  }

  h1 span + span {
    color: var(--copper);
  }

  .sub {
    font-size: var(--step-1);
    line-height: 1.4;
    max-width: 30ch;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    margin: var(--space-3) 0 0;
  }

  .actions a {
    display: inline-block;
    padding: 0.3rem 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-2);
    letter-spacing: 0.01em;
  }

  .actions a:first-child {
    color: var(--ink);
    text-decoration-color: var(--copper);
    text-decoration-thickness: 3px;
  }

  .figure {
    max-width: 38rem;
    width: 100%;
    justify-self: center;
  }

  @media (min-width: 64rem) {
    .hero {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--space-3);
      min-height: min(48rem, calc(100dvh - 8rem));
    }

    .figure {
      justify-self: end;
    }
  }
</style>
