---
// Typographic cover for projects without a screenshot: the name in Big Shoulders on
// kraft, the main language in copper.
interface Props {
  title: string;
  language?: string;
}

const { title, language } = Astro.props;
---

<div class="cover kraft" aria-hidden="true">
  <span class="name">{title}</span>
  {language && <span class="lang">{language}</span>}
</div>

<style>
  .cover {
    aspect-ratio: 16 / 10;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 0.6em 0.7em;
    border: 1px solid var(--ink);
    border-radius: var(--radius-img);
    container-type: inline-size;
    overflow: hidden;
  }

  .name {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(1rem, 17cqw, 3rem);
    line-height: 0.9;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .lang {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(0.75rem, 9cqw, 1.25rem);
    color: var(--copper);
  }
</style>
