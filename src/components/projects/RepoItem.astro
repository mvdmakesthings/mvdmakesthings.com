---
import type { Repo } from '../../lib/projects';

interface Props {
  repo: Repo;
}

const { repo } = Astro.props;
const updated = new Date(`${repo.pushedAt.slice(0, 10)}T12:00:00Z`).toLocaleDateString('en-US', {
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<li class="repo">
  <h3 class="name"><a href={repo.url}>{repo.name}</a></h3>
  <p class="desc">{repo.description ?? 'No description yet.'}</p>
  <p class="meta">
    {repo.language && <span>{repo.language}</span>}
    <span>Updated <time datetime={repo.pushedAt.slice(0, 10)}>{updated}</time></span>
    {repo.stars > 0 && <span>{repo.stars} {repo.stars === 1 ? 'star' : 'stars'}</span>}
    {repo.homepage && <a href={repo.homepage}>Homepage</a>}
  </p>
</li>

<style>
  .repo {
    padding: var(--space-2) 0;
  }

  .name {
    font-size: var(--step-1);
    margin-bottom: 0.25rem;
  }

  .name a {
    color: var(--ink);
    text-decoration-color: var(--copper);
  }

  .desc {
    max-width: var(--measure);
    margin-bottom: 0.25rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-2);
    margin: 0;
  }
</style>
