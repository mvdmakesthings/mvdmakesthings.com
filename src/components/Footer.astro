---
import { site, socialLinks } from '../data/site';

interface Props {
  sheet: string;
}

const { sheet } = Astro.props;
const rev = new Date().toISOString().slice(0, 10);
---

<footer class="site-footer" transition:animate="none">
  <ul class="links" aria-label="Elsewhere">
    {socialLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
    {site.email && <li><a href={`mailto:${site.email}`}>Email</a></li>}
  </ul>

  <dl class="title-block">
    <div class="cell site">
      <dt>Title</dt>
      <dd>mvdmakesthings.com</dd>
    </div>
    <div class="cell">
      <dt>Drawn by</dt>
      <dd>{site.name}, Louisville</dd>
    </div>
    <div class="cell">
      <dt>Sheet</dt>
      <dd>{sheet}</dd>
    </div>
    <div class="cell">
      <dt>Process</dt>
      <dd>Built with Astro</dd>
    </div>
    <div class="cell">
      <dt>Rev</dt>
      <dd><time datetime={rev}>{rev}</time></dd>
    </div>
    <div class="cell">
      <dt>Source</dt>
      <dd><a href={site.source}>Source on GitHub</a></dd>
    </div>
    <div class="cell">
      <dt>Hire</dt>
      <dd><a href="/resume/">Work with me</a></dd>
    </div>
  </dl>
</footer>

<style>
  .site-footer {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-3) var(--pad) 0;
    border-top: 1px solid var(--ink);
  }

  .links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    align-self: end;
    font-size: var(--step--1);
  }

  .links a {
    display: inline-block;
    padding: 0.35rem 0;
  }

  /* Hairlines between cells come from the 1px grid gap over an ink background. */
  .title-block {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin: 0 calc(-1 * var(--pad));
    background: var(--ink);
    border-top: 1px solid var(--ink);
  }

  .cell {
    padding: 0.4rem 0.75rem 0.5rem;
    background: var(--paper);
    min-width: 0;
  }

  .cell.site {
    grid-column: 1 / -1;
  }

  @media (min-width: 48rem) {
    .title-block {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  dt {
    font-size: 0.75rem;
    line-height: 1.2;
    color: var(--pencil);
  }

  dd {
    margin: 0;
    font-size: var(--step--1);
    line-height: 1.3;
  }

  .site dd {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--step-2);
    line-height: 1.05;
    letter-spacing: -0.01em;
  }

  @media (min-width: 64rem) {
    .site-footer {
      grid-template-columns: 1fr minmax(0, 34rem);
      padding: 0 0 0 var(--pad);
    }

    .links {
      padding-bottom: var(--space-2);
    }

    .title-block {
      margin: 0;
      border-top: 0;
      border-left: 1px solid var(--ink);
    }
  }
</style>
