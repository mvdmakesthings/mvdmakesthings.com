---
import { site } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<header class="site-header" transition:animate="none">
  <a class="wordmark" href="/" transition:name="wordmark">
    <span class="mark">MVD</span>
    <span class="tag">makes things</span>
    <span class="visually-hidden">, home</span>
  </a>
  <button class="menu-button" type="button" aria-expanded="false" aria-controls="site-nav">
    Menu
  </button>
  <nav id="site-nav" class="site-nav" aria-label="Main">
    <ul>
      {
        site.nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <ThemeToggle />
</header>

<script>
  document.addEventListener('click', (event) => {
    const button = (event.target as Element | null)?.closest('.menu-button');
    if (!button) return;
    const open = button.getAttribute('aria-expanded') !== 'true';
    button.setAttribute('aria-expanded', String(open));
  });
</script>

<style>
  .site-header {
    display: grid;
    grid-template-columns: 1fr auto auto;
    grid-template-areas:
      'mark menu theme'
      'nav nav nav';
    align-items: center;
    column-gap: var(--space-1);
    padding: var(--space-1) var(--pad);
    border-bottom: 1px solid var(--ink);
  }

  .wordmark {
    grid-area: mark;
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    color: var(--ink);
    text-decoration: none;
    padding: var(--space-1) 0;
  }

  .mark {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 2rem;
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .tag {
    font-style: italic;
    font-size: var(--step--1);
    color: var(--pencil);
  }

  .menu-button {
    grid-area: menu;
    min-height: 2.75rem;
    padding: 0 var(--space-1);
    border: 0;
    background: none;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .site-nav {
    grid-area: nav;
  }

  .site-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav a {
    display: block;
    padding: 0.6rem 0;
    color: var(--ink);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-1);
    letter-spacing: 0.01em;
  }

  .site-nav a:hover,
  .site-nav a[aria-current='page'] {
    color: var(--copper);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }

  .theme-toggle {
    grid-area: theme;
  }

  /* With JS, the phone menu collapses behind its button; without JS it stays open. */
  :global(html.js) .menu-button[aria-expanded='false'] + .site-nav {
    display: none;
  }

  :global(html:not(.js)) .menu-button {
    display: none;
  }

  .site-nav ul {
    border-top: 1px solid var(--pencil);
    margin-top: var(--space-1);
  }

  @media (min-width: 48rem) {
    .site-header {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: 'mark nav theme';
    }

    .menu-button {
      display: none;
    }

    :global(html.js) .menu-button[aria-expanded='false'] + .site-nav {
      display: block;
    }

    .site-nav ul {
      display: flex;
      justify-content: flex-end;
      gap: var(--space-3);
      border: 0;
      margin: 0;
    }

    .site-nav a {
      font-size: var(--step-0);
    }
  }
</style>
