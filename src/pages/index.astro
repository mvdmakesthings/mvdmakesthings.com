---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import HomeProjects from '../components/HomeProjects.astro';
import HomeWriting from '../components/HomeWriting.astro';
import HomeArt from '../components/HomeArt.astro';
import Bio from '../components/Bio.astro';
import { site } from '../data/site';

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  alternateName: 'MVD',
  url: site.url,
  image: new URL('/apple-touch-icon.png', site.url).href,
  jobTitle: 'Engineering leader',
  description: site.description,
  address: { '@type': 'PostalAddress', addressLocality: 'Louisville', addressRegion: 'KY', addressCountry: 'US' },
  sameAs: Object.values(site.links),
};
---

<Base sheet="Home">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(person)} />
  <Hero />
  <HomeProjects />
  <div class="pair">
    <HomeWriting />
    <HomeArt />
  </div>
  <Bio />
</Base>

<style>
  .pair {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid var(--ink);
  }

  @media (min-width: 64rem) {
    .pair {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-5);
    }
  }
</style>
