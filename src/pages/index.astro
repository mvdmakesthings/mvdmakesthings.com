---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import HomeProjects from '../components/HomeProjects.astro';
import HomeArt from '../components/HomeArt.astro';
import Bio from '../components/Bio.astro';
import { graph, person, website } from '../lib/schema';

const jsonLd = graph(website(), await person());
---

<Base sheet="Home">
  <script type="application/ld+json" slot="head" set:html={jsonLd} />
  <Hero />
  <HomeProjects />
  <div class="art">
    <HomeArt />
  </div>
  <Bio />
</Base>

<style>
  .art {
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid var(--ink);
  }
</style>
