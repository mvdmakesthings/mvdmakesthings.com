---
import Base from '../layouts/Base.astro';
import Gallery from '../components/art/Gallery.astro';
import { isPlaceholder, pieces } from '../lib/art';
import { site } from '../data/site';

const all = await pieces();
const placeholders = all.some(isPlaceholder);
---

<Base
  title="Art"
  sheet="Art"
  description="Art by Michael VanDyke: Hello, Hun, a phone installation of his great-grandmother's stories; MoonDew, generative art in Python; and electronic music as alluvium."
>
  <h1 class="page-title">Art</h1>
  <p class="lede">Installations, generative art, and music. Open a piece to watch or listen.</p>
  {
    placeholders && (
      <p class="note">
        The gallery is still being hung, so these are stand-ins. In the meantime, the real work is on{' '}
        <a href={site.links.instagram}>Instagram</a>.
      </p>
    )
  }
  {all.length === 0 ? <p>Nothing hung yet.</p> : <Gallery pieces={all} />}
</Base>

<style>
  .note {
    max-width: var(--measure);
    padding: var(--space-2);
    border: 1px solid var(--ink);
    margin-bottom: var(--space-4);
  }
</style>
