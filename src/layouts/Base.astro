---
import { ClientRouter, fade } from 'astro:transitions';
import { Font } from 'astro:assets';
import Analytics from '@vercel/analytics/astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Name of this page in the footer title block. */
  sheet: string;
  /** Absolute or root-relative path to a 1200x630 social preview image. */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  /** Article dates, for og:article tags. */
  published?: Date;
  modified?: Date;
  /** Keep this page out of search results, e.g. the 404 page. */
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  sheet,
  image = '/og.jpg',
  imageAlt = 'Michael VanDyke beside the headline: I take things apart to see how they work. Then I make new ones.',
  type = 'website',
  published,
  modified,
  noindex = false,
} = Astro.props;
const fullTitle = title ? `${title} | ${site.title}` : `${site.name}, engineering leader and maker | ${site.title}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site).href;
const imageType = image.endsWith('.png') ? 'image/png' : 'image/jpeg';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.title}: Writing`} href="/rss.xml" />
    <meta name="theme-color" content="#fbfbf9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1b1814" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={title ?? site.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content={imageType} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    {type === 'article' && <meta property="article:author" content={site.url} />}
    <meta name="twitter:card" content="summary_large_image" />

    <slot name="head" />

    <script is:inline>
      // Set the theme before first paint so there is no flash, and again after
      // each client-side navigation swaps in a fresh <html>.
      (() => {
        const apply = (doc) => {
          let theme = null;
          try {
            theme = localStorage.getItem('theme');
          } catch {}
          if (theme !== 'light' && theme !== 'dark') {
            theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          doc.documentElement.dataset.theme = theme;
          doc.documentElement.classList.add('js');
        };
        apply(document);
        document.addEventListener('astro:before-swap', (event) => apply(event.newDocument));
      })();
    </script>

    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-mono" />
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="sheet">
      <Header />
      <main id="main" transition:animate={fade({ duration: '180ms' })}>
        <slot />
      </main>
      <Footer sheet={sheet} />
    </div>
    <Analytics />
  </body>
</html>
